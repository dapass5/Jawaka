# In-game shortcut bindings.
# "Game Switcher" follows the existing "Switcher" -> 游戏切换; "Screenshot"
# follows "Screenshots" -> 截图; "Disabled" pairs with "Enabled" -> 已启用.
msgid "Disabled"
msgstr "已禁用"

msgid "Game Switcher"
msgstr "游戏切换"

msgid "Screenshot"
msgstr "截图"

# In-game Shortcuts page.
# 保存 follows the existing "Save & Quit" -> 保存并退出 / "Saving" -> 保存中.
# 快捷键 is the usual term for a shortcut key binding.
msgid "In-game Shortcuts"
msgstr "游戏内快捷键"

msgid "Screenshot Shortcut"
msgstr "截图快捷键"

msgid "Recording Shortcut"
msgstr "录制快捷键"

# Now one printf string, so the action name can sit where Chinese wants it:
# "<action> 已占用" reads as "<action> already has it", rather than the
# English order the old two-fragment concatenation forced.
msgid "Already used by %s"
msgstr "已被 %s 占用"

msgid "Could not save"
msgstr "无法保存"

# In-game Shortcuts help line.
msgid "Hold Menu, then press the button.   X: Disable"
msgstr "按住 Menu，再按对应按键。   X：禁用"

# Shown when the binding persisted but the daemon push failed.
msgid "Saved; active after restart"
msgstr "已保存；重启后生效"

# Shortcut picker.
# Follows the file's own entries: "Choose" -> 选择, "Back" -> 返回.
msgid "A: Choose   B: Back"
msgstr "A：选择   B：返回"

# Header fallback when the action name is unavailable; "Shortcut" alone.
msgid "Shortcut"
msgstr "快捷键"

# In-game shader picker. Reviewed by dapass5 in PR #117 review; fuzzy cleared.
msgid "Advanced RetroArch menu"
msgstr "RetroArch 高级菜单"

msgid "All RetroArch"
msgstr "所有 RetroArch 游戏"

msgid "All RetroArch requires a Leaf build with Fugazi's conflict resolver."
msgstr "所有 RetroArch 游戏需要包含 Fugazi 冲突解析器的 Leaf 版本。"

msgid "Remove the saved preset at the selected scope and turn shaders off."
msgstr "移除所选作用范围内已保存的预设，并关闭着色器。"

msgid "Edit the current shader in RetroArch."
msgstr "在 RetroArch 中编辑当前着色器。"

msgid "Leaf's in-game picker supports GLSL presets (.glslp)."
msgstr "Leaf 的游戏内选择器支持 GLSL 预设（.glslp）。"

msgid "Leaf's shader files are incomplete. Update or reinstall Leaf."
msgstr "Leaf 的着色器文件不完整。请更新或重新安装 Leaf。"

msgid "No saved shader exists at that scope."
msgstr "该作用范围内没有已保存的着色器。"

msgid "Save your edits in RetroArch before you leave."
msgstr "离开前，请在 RetroArch 中保存修改。"

msgid "Recommended shaders are unavailable. Update or reinstall Leaf."
msgstr "推荐的着色器不可用。请更新或重新安装 Leaf。"

msgid "RetroArch did not confirm the shader. Reopen Shader or restart the game."
msgstr "RetroArch 未确认着色器。请重新打开“着色器”或重启游戏。"

msgid "RetroArch is not available. Shader unchanged."
msgstr "RetroArch 不可用。着色器未更改。"

msgid "Save globally"
msgstr "全局保存"

msgid "Save current shader…"
msgstr "保存当前着色器…"

msgid "Choose where RetroArch should load this shader automatically."
msgstr "选择 RetroArch 应自动加载此着色器的作用范围。"

msgid "A broader preset may apply after you reload the game."
msgstr "重新加载游戏后，可能会应用作用范围更广的预设。"

msgid "Scope"
msgstr "作用范围"

msgid "Shader"
msgstr "着色器"

msgid "Shader failed and the previous shader could not be restored. Reopen the game."
msgstr "着色器应用失败，且无法恢复之前的着色器。请重新打开游戏。"

msgid "Shader is active for this session, but could not be saved for %s."
msgstr "着色器在本次会话中已启用，但无法保存到%s。"

msgid "Shader operation failed."
msgstr "着色器操作失败。"

msgid "Shader scope"
msgstr "着色器作用范围"

msgid "The saved shader could not be removed."
msgstr "无法移除已保存的着色器。"

msgid "This RetroArch build does not support Leaf's shader picker."
msgstr "当前 RetroArch 版本不支持 Leaf 的着色器选择器。"

msgid "This folder"
msgstr "此文件夹"

msgid "This game"
msgstr "此游戏"

msgid "This replaces the shader for every RetroArch game and can replace Fugazi. Continue?"
msgstr "这会替换所有 RetroArch 游戏的着色器，也可能替换 Fugazi。是否继续？"

msgid "This shader could not compile or link on this video driver. Previous shader restored."
msgstr "此着色器无法在当前视频驱动下编译或链接。已恢复之前的着色器。"

msgid "Use Advanced to edit it in RetroArch."
msgstr "使用高级选项在 RetroArch 中编辑。"

msgid "that scope"
msgstr "该作用范围"

